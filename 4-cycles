#Задача 12
n = int(input())
max_digit = 0
min_digit = 9
while n > 0:
    digit = n % 10
    if digit > max_digit:
        max_digit = digit
    if digit < min_digit:
        min_digit = digit
    n //= 10
print(f"Максимальная цифра: {max_digit}")
print(f"Минимальная цифра: {min_digit}")

#Задача 13
n = int(input())
digits_sum = 0
digits_count = 0
digits_product = 1
first_digit = None

original_n = n

while n > 0:
    digit = n % 10
    digits_sum += digit
    digits_count += 1
    digits_product *= digit
    n //= 10
    if n == 0:
        first_digit = digit
        
last_digit = original_n % 10

print(f"Сумма цифр: {digits_sum}")
print(f"Количество цифр: {digits_count}")
print(f"Произведение цифр: {digits_product}")
print(f"Среднее арифметическое: {digits_sum / digits_count}")
print(f"Первая цифра: {first_digit}")
print(f"Сумма первой и последней цифры: {first_digit + last_digit}")

