#Задача 8
s = input()
print(f"Общее количество символов: {len(s)}")
print(f"Строка, повторенная 3 раза: {s * 3}")
print(f"Первый символ: {s[0]}")
print(f"Первые три символа: {s[:3]}")
print(f"Последние три символа: {s[-3:]}")
print(f"Строка в обратном порядке: {s[::-1]}")
print(f"Строка без первого и последнего символа: {s[1:-1]}")

