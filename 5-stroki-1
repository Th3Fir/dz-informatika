#Задача 2
s = input()
count_plus = 0
count_star = 0
for char in s:
    if char == '+':
        count_plus += 1
    elif char == '*':
        count_star += 1
print(f"Символ + встречается {count_plus} раз")
print(f"Символ * встречается {count_star} раз")

