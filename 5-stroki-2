#Задача 5
letters = "АВЕКМНОРСТУХ"
number = input().strip()

if len(number) not in (8, 9):
    print("NO")
else:
    if len(number) == 8:
        parts = [number[0], number[1:4], number[4:6], number[6:8]]
    else:  # 9 символов
        parts = [number[0], number[1:4], number[4:6], number[6:9]]
    valid = True
    
    # Первая буква
    if parts[0] not in letters:
        valid = False
    
    # Первые три цифры
    if not parts[1].isdigit() or len(parts[1]) != 3:
        valid = False
    
    # Две буквы
    if len(parts[2]) != 2 or parts[2][0] not in letters or parts[2][1] not in letters:
        valid = False
    
    # Последние цифры 2 или 3
    if not parts[3].isdigit() or len(parts[3]) not in (2, 3):
        valid = False
    
    print("YES" if valid else "NO")

