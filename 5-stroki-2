#Задача 3
word = input()
if word.endswith('es'):
    result = word[:-2] + 'e'
elif word.endswith('y') and len(word) > 1:
    consonants = 'бвгджзйклмнпрстфхцчшщbcdfghjklmnpqrstvwxyz'
    if word[-2] in consonants:
        result = word[:-1] + 'ies'
    else:
        result = word + 's'
elif word.endswith(('ch', 'x', 'sh', 'ss', 's')):
    result = word + 'es'
elif word.endswith('f'):
    result = word[:-1] + 'ves'
elif word.endswith('fe'):
    result = word[:-2] + 'ves'
else:
    result = word + 's'
print(result)

